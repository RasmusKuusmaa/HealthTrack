    "/entities/{entity_type}/{entity_id}/revert": {
      "post": {
        "tags": [
          "entities"
        ],
        "summary": "Revert Entity",
        "description": "Restore an entity's fields to their state as of a prior point in its\nhistory. This does not rewrite history \u2014 it emits a brand new UPDATE\nop (through the normal push pipeline) setting the current fields back\nto those prior values, and shows up as its own entry in future history\nqueries. See docs/sync-protocol.md.",
        "operationId": "revert_entity_entities__entity_type___entity_id__revert_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "entity_type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Entity Type"
            }
          },
          {
            "name": "entity_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Entity Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevertRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushOpResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
