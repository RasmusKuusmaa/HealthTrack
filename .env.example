# Copy to .env and adjust as needed. This file documents every environment
# variable used across docker-compose.yml and the services that read them.

# --- API service ---
API_PORT=8000

# --- PostgreSQL ---
POSTGRES_USER=healthtrack
POSTGRES_PASSWORD=healthtrack
POSTGRES_DB=healthtrack
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=healthtrack
MINIO_ROOT_PASSWORD=healthtrack123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
